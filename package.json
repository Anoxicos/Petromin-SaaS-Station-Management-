{
  "name": "station-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "build:prod": "tsc --noEmit false --outDir dist",
    "start": "node dist/index.js",
    "test:auth": "node --experimental-strip-types scripts/auth0-flow-test.mjs",
    "test:load": "node scripts/load-test-harness-test.mjs",
    "test:xlsx": "node --experimental-strip-types scripts/xlsx-export-test.mjs",
    "test:imports": "node --experimental-strip-types scripts/import-parser-test.mjs",
    "test:ui": "node scripts/ui-navigation-test.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
